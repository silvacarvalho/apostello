{
	"servers": {
		"apostello": {
			"command": "npx",
			"args": [
				"-y",
				"@modelcontextprotocol/server-postgres@0.6.2",
				"${input:connectionString}"
			],
			"type": "stdio"
		}
	},
	"inputs": [
		{
			"id": "connectionString",
			"type": "promptString",
			"description": "PostgreSQL connection URI (e.g. postgresql://user:pass@localhost:5432/dbname)"
		}
	]
}